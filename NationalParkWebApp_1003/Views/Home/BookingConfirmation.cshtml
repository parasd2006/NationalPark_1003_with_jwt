@{
    ViewData["Title"] = "Booking Confirmation";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6 text-center">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">

                    <!-- Success Checkmark -->
                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle" style="width: 90px; height: 90px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="55" height="55" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
                            </svg>
                        </div>
                        <h2 class="fw-bold text-success mt-3 mb-1">Booking Confirmed!</h2>
                        <p class="text-muted">Your appointment has been successfully booked.</p>
                    </div>

                    <!-- Details Card -->
                    <div class="bg-light rounded-3 p-4 text-start mb-4 border">
                        @if (ViewBag.AppointmentId != null && (int)ViewBag.AppointmentId > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                <span class="text-muted">Booking Reference:</span>
                                <strong class="text-dark">#@ViewBag.AppointmentId</strong>
                            </div>
                        }
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">National Park ID:</span>
                            <span class="badge bg-primary fs-6">#@ViewBag.ParkId</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Park Name:</span>
                            <strong class="text-dark">@ViewBag.ParkName</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Status:</span>
                            <span class="badge bg-success">Confirmed / Approved Payment</span>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-action="Index" asp-controller="Home" class="btn btn-primary px-4 py-2">
                            Back to Home
                        </a>
                        <button onclick="window.print()" class="btn btn-outline-secondary px-4 py-2">
                            Print Slip
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>